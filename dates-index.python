# College Event Management System

events = []

def add_event():
    name = input("Enter Event Name: ")
    date = input("Enter Event Date: ")
    venue = input("Enter Event Venue: ")
    
    event = {
        "name": name,
        "date": date,
        "venue": venue
    }
    
    events.append(event)
    print("Event Added Successfully!\n")


def view_events():
    if len(events) == 0:
        print("No events available.\n")
    else:
        print("\nList of Events:")
        for i, event in enumerate(events):
            print(f"{i+1}. {event['name']} | {event['date']} | {event['venue']}")
        print()


def delete_event():
    view_events()
    if len(events) > 0:
        choice = int(input("Enter event number to delete: "))
        if 1 <= choice <= len(events):
            events.pop(choice - 1)
            print("Event Deleted Successfully!\n")
        else:
            print("Invalid choice.\n")


while True:
    print("---- College Event Management System ----")
    print("1. Add Event")
    print("2. View Events")
    print("3. Delete Event")
    print("4. Exit")

    option = input("Choose option: ")

    if option == "1":
        add_event()
    elif option == "2":
        view_events()
    elif option == "3":
        delete_event()
    elif option == "4":
        print("Thank You!")
        break
    else:
        print("Invalid Option\n")
